{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "StockLab.Api",
    "Audience": "StockLab.Frontend",
    "AccessTokenMinutes": 60
  },
  "LoginRateLimit": {
    "PermitLimit": 5,
    "Window": "00:01:00"
  },
  "MarketData": {
    "Provider": "Mock"
  },
  "TwelveData": {
    "ActiveWebsiteKey": "Website",
    "TimeoutSeconds": 10
  },
  "MarketDataRateLimit": {
    "PermitLimit": 30,
    "Window": "00:01:00",
    "QueueLimit": 10
  },
  "MarketDataCache": {
    "SizeLimit": 8388608,
    "QuoteTtl": "00:00:15",
    "SearchTtl": "00:05:00",
    "HistoryTtl": "00:15:00"
  },
  "AlphaVantage": {
    "TimeoutSeconds": 10,
    "DailyRequestBudget": 20
  }
}
