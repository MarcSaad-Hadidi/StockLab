{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MarketDataRateLimit": {
    "PermitLimit": 30,
    "Window": "00:01:00",
    "QueueLimit": 10
  },
  "MarketDataCache": {
    "SizeLimit": 8388608,
    "QuoteTtl": "00:00:15",
    "SearchTtl": "00:05:00",
    "HistoryTtl": "00:15:00"
  }
}
