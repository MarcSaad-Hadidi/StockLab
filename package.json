{
  "name": "stocklab",
  "private": true,
  "scripts": {
    "setup": "npm install && npm --prefix frontend install && dotnet restore backend/StockLab.sln",
    "dev": "concurrently --kill-others --names api,web --prefix-colors blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "dotnet run --project backend/StockLab.Api/StockLab.Api.csproj --launch-profile http",
    "dev:web": "npm --prefix frontend run dev -- --host 127.0.0.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
